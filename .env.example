# --- Postgres ---
POSTGRES_USER=support_saas
POSTGRES_PASSWORD=support_saas_dev
POSTGRES_DB=support_saas

# --- App / DB (used directly by the api container when not overridden by docker-compose) ---
DATABASE_URL=postgresql+asyncpg://support_saas:support_saas_dev@localhost:5432/support_saas

# --- Redis / Celery (wired up in phase 2) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- LLM (Anthropic, used starting phase 3/4) ---
ANTHROPIC_API_KEY=

# --- Misc ---
ENVIRONMENT=development
